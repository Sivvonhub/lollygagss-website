{
  "cleanUrls": true,
  "redirects": [
    { "source": "/fb", "destination": "/?utm_source=facebook&utm_medium=social&utm_campaign=bali-tourist-info", "permanent": false },
    { "source": "/lash-fb", "destination": "/lash-extensions-kerobokan?utm_source=facebook&utm_medium=social&utm_campaign=lash-extensions-kerobokan", "permanent": false },
    { "source": "/lash-threads", "destination": "/lash-extensions-kerobokan?utm_source=threads&utm_medium=social&utm_campaign=lash-extensions-kerobokan", "permanent": false },
    { "source": "/lash-gbp", "destination": "/lash-extensions-kerobokan?utm_source=google&utm_medium=gbp_post&utm_campaign=lash-extensions-kerobokan", "permanent": false },
    { "source": "/journal/biab-nails-kerobokan", "destination": "/biab-manicure-kerobokan", "permanent": true },
    { "source": "/journal/lash-extensions-kerobokan", "destination": "/lash-extensions-kerobokan", "permanent": true }
  ],
  "rewrites": [
    { "source": "/gallery", "destination": "/" },
    { "source": "/about", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/home", "destination": "/" },
    { "source": "/id/gallery", "destination": "/id" },
    { "source": "/id/about", "destination": "/id" },
    { "source": "/id/contact", "destination": "/id" },
    { "source": "/id/home", "destination": "/id" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*).woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
